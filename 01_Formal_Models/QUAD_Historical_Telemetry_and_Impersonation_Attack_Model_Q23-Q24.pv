(*
QUAD -- Historical Telemetry and Future Impersonation (Q23-Q24)
ProVerif 2.05

Q23 tests historical U2G telemetry after disclosure of both the UAV-GCS
long-term shared key and GCS static ML-KEM private key following M6.
Q24 tests a future UAV-impersonation witness after prior disclosure of the
target UAV long-term shared key; no honest UAV process is present for the
target identity in this scenario.

The public-channel source-IP envelope models receiver-side metadata, not
an M1/M3 wire field. The attacker can supply source-IP labels; UDP
anti-spoofing and expiration are outside the symbolic model.
*)
set traceDisplay = short.
set reconstructTrace = true.
set displayDerivation = false.

free c: channel.

type host.
type ip_t.
type slot_t.
type nonce.
type seq_t.
type len_t.
type gcm_nonce_t.
type pkey.
type skey.
type ss_t.
type ct_t.
type sym_key.
type mac_t.
type cookie_t.
type hash_t.
type sid_t.
type aead_t.

free Dir_U2G: bitstring.
free Dir_G2U: bitstring.
free Epoch0: bitstring.

fun hmac(sym_key, bitstring): mac_t.
fun hash2bits(hash_t): bitstring [data].
fun calc_cookie(sym_key, ip_t, slot_t, nonce): cookie_t.

fun mlkem_pk(skey): pkey.
fun mlkem_encaps_ct(pkey, nonce): ct_t.
fun mlkem_encaps_ss(pkey, nonce): ss_t.
fun mlkem_decaps(skey, ct_t): ss_t.
equation forall k:skey, r:nonce;
  mlkem_decaps(k,mlkem_encaps_ct(mlkem_pk(k),r))
  = mlkem_encaps_ss(mlkem_pk(k),r).

fun canon_m2(slot_t, nonce, cookie_t): bitstring [data].
fun canon_m3(host, slot_t, nonce, nonce, cookie_t, ct_t, mac_t): bitstring [data].
fun canon_m4(sid_t, mac_t): bitstring [data].
fun canon_m5(sid_t, mac_t): bitstring [data].
fun make_th3(bitstring, bitstring, bitstring): hash_t [data].
fun make_th4(hash_t, bitstring): hash_t [data].
fun make_th5(hash_t, bitstring): hash_t [data].
fun make_sid(hash_t): sid_t [data].

fun macu_input(host, host, slot_t, nonce, nonce, cookie_t, ct_t): bitstring [data].
fun info_ksym(hash_t): bitstring [data].
fun info_fin_g(hash_t): bitstring [data].
fun info_fin_u(hash_t): bitstring [data].
fun info_es(bitstring, hash_t): bitstring [data].
fun info_u2g(sid_t, bitstring): bitstring [data].
fun info_g2u(sid_t, bitstring): bitstring [data].
fun hkdf_extract_hs(mac_t, ss_t): sym_key.
fun hkdf_expand(sym_key, bitstring): sym_key.

fun make_gcm_nonce(bitstring, seq_t): gcm_nonce_t [data].
fun make_aad(sid_t, bitstring, bitstring, seq_t, bitstring, len_t): bitstring [data].
fun aead_enc(sym_key, gcm_nonce_t, bitstring, bitstring): aead_t.
reduc forall k:sym_key, n:gcm_nonce_t, ad:bitstring, m:bitstring;
  aead_dec(k,n,ad,aead_enc(k,n,ad,m)) = m.

fun payload_telemetry(bitstring): bitstring [data].
reduc forall x:bitstring; get_telemetry(payload_telemetry(x)) = x.

free ClientHello_Init: bitstring.
free CookieReply: bitstring.
free ClientAuth: bitstring.
free ServerFinished: bitstring.
free ClientFinished: bitstring.

free Type_SessionReady: bitstring.
free Len_SessionReady: len_t.
free Payload_READY: bitstring.
free Type_Telemetry: bitstring.
free Len_Telemetry_Test: len_t.

(* Historical dual-compromise scenario. *)
free sk_C: skey [private].
free ltsk_C: sym_key [private].
free mk_C: sym_key [private].
free id_C_u: host.
free id_C_g: host.
free ip_C: ip_t.
free secret_both_broken: bitstring [private].

(* Future impersonation scenario. *)
free sk_F: skey [private].
free ltsk_F: sym_key [private].
free mk_F: sym_key [private].
free id_F_u: host.
free id_F_g: host.

(* Public nonce material available to the Dolev-Yao attacker so it can execute
   the public ML-KEM encapsulation algorithm and choose its own N_U. *)
free attacker_r_F: nonce.
free attacker_nu_F: nonce.

free future_impersonation_witness: bitstring [private].

event PastSessionBeforeDualCompromise.
event LTSKCompromisedBeforeFutureHandshake.

query attacker(secret_both_broken).
query attacker(future_impersonation_witness).

let processPastSessionThenBothBroken() =
  let pkC = mlkem_pk(sk_C) in
  out(c,pkC);
  new slotC:slot_t;
  new ngC:nonce;
  new nuC:nonce;
  new rC:nonce;
  let cookieC = calc_cookie(mk_C,ip_C,slotC,ngC) in
  let ctC = mlkem_encaps_ct(pkC,rC) in
  let ssC = mlkem_encaps_ss(pkC,rC) in
  let macC = hmac(
      ltsk_C,macu_input(id_C_u,id_C_g,slotC,nuC,ngC,cookieC,ctC)) in

  let m2C = canon_m2(slotC,ngC,cookieC) in
  let m3C = canon_m3(id_C_u,slotC,nuC,ngC,cookieC,ctC,macC) in
  let th3C = make_th3(ClientHello_Init,m2C,m3C) in
  let ksymC = hmac(ltsk_C,info_ksym(th3C)) in
  let prkC = hkdf_extract_hs(ksymC,ssC) in
  let sidC = make_sid(th3C) in
  let kfgC = hkdf_expand(prkC,info_fin_g(th3C)) in
  let fingC = hmac(kfgC,hash2bits(th3C)) in
  let th4C = make_th4(th3C,canon_m4(sidC,fingC)) in
  let kfuC = hkdf_expand(prkC,info_fin_u(th4C)) in
  let finuC = hmac(kfuC,hash2bits(th4C)) in
  let th5C = make_th5(th4C,canon_m5(sidC,finuC)) in
  let esC = hkdf_expand(prkC,info_es(Epoch0,th5C)) in
  let kuC = hkdf_expand(esC,info_u2g(sidC,Epoch0)) in
  let kgC = hkdf_expand(esC,info_g2u(sidC,Epoch0)) in

  (* Public historical M1--M6 transcript, followed by protected data.
     This is an orchestrated honest historical handshake (not an arbitrary
     concurrent-session authentication proof). Time expiry and true source-IP provenance are abstracted; ip_C is the
     source IP of this honest recorded session. *)
  out(c,(ip_C,ClientHello_Init));
  out(c,(CookieReply,slotC,ngC,cookieC));
  out(c,(ip_C,(ClientAuth,id_C_u,slotC,nuC,ngC,cookieC,ctC,macC)));
  out(c,(ServerFinished,sidC,fingC));
  out(c,(ClientFinished,sidC,finuC));

  (* M6 GCS -> UAV under the new G2U Epoch-0 key.
     The UAV must receive an authentic READY before historical data starts. *)
  new seqReadyC:seq_t;
  let aadReadyC = make_aad(
      sidC,Dir_G2U,Epoch0,seqReadyC,Type_SessionReady,Len_SessionReady) in
  let encReadyC = aead_enc(
      kgC,make_gcm_nonce(Epoch0,seqReadyC),aadReadyC,Payload_READY) in
  out(c,(sidC,Dir_G2U,Epoch0,seqReadyC,
         Type_SessionReady,Len_SessionReady,encReadyC));
  in(c,(=sidC,=Dir_G2U,=Epoch0,seqReadyRx:seq_t,
         =Type_SessionReady,=Len_SessionReady,encReadyRx:aead_t));
  let aadReadyRx = make_aad(
      sidC,Dir_G2U,Epoch0,seqReadyRx,Type_SessionReady,Len_SessionReady) in
  let readyPlainC = aead_dec(
      kgC,make_gcm_nonce(Epoch0,seqReadyRx),aadReadyRx,encReadyRx) in
  if readyPlainC = Payload_READY then

  new seqC:seq_t;
  let nonceC = make_gcm_nonce(Epoch0,seqC) in
  let aadC = make_aad(
      sidC,Dir_U2G,Epoch0,seqC,Type_Telemetry,Len_Telemetry_Test) in
  out(c,(sidC,Dir_U2G,Epoch0,seqC,Type_Telemetry,Len_Telemetry_Test,
         aead_enc(kuC,nonceC,aadC,payload_telemetry(secret_both_broken))));

  event PastSessionBeforeDualCompromise;
  (* Both long-term anchors are leaked only after the historical session. *)
  out(c,ltsk_C);
  out(c,sk_C).

let processFutureImpersonationAfterLTSK() =
  let pkF = mlkem_pk(sk_F) in
  out(c,pkF);

  (* There is intentionally NO honest UAV process for id_F_u. *)
  event LTSKCompromisedBeforeFutureHandshake;
  out(c,ltsk_F);

  (* M1 from the attacker. *)
  (* Receiver-observed metadata accompanies M1 on the symbolic channel. *)
  in(c,(ip_f_m1:ip_t,=ClientHello_Init));

  (* GCS returns M2. *)
  new slotF:slot_t;
  new ngF:nonce;
  let cookieF = calc_cookie(mk_F,ip_f_m1,slotF,ngF) in
  out(c,(CookieReply,slotF,ngF,cookieF));

  (* Attacker forges M3 after learning LTSK_F. *)
  in(c,(ip_f_m3:ip_t,(=ClientAuth,=id_F_u,=slotF,nu_recv:nonce,=ngF,=cookieF,
        ct_recv:ct_t,mac_recv:mac_t)));
  (* The attacker must present a Cookie for the IP observed on M3. *)
  if cookieF = calc_cookie(mk_F,ip_f_m3,slotF,ngF) then
  if mac_recv = hmac(
      ltsk_F,macu_input(id_F_u,id_F_g,slotF,nu_recv,ngF,cookieF,ct_recv)) then
    let ssF = mlkem_decaps(sk_F,ct_recv) in
    let th3F = make_th3(
        ClientHello_Init,
        canon_m2(slotF,ngF,cookieF),
        canon_m3(id_F_u,slotF,nu_recv,ngF,cookieF,ct_recv,mac_recv)) in
    let ksymF = hmac(ltsk_F,info_ksym(th3F)) in
    let prkF = hkdf_extract_hs(ksymF,ssF) in
    let sidF = make_sid(th3F) in
    let kfgF = hkdf_expand(prkF,info_fin_g(th3F)) in
    let fingF = hmac(kfgF,hash2bits(th3F)) in

    (* M4. *)
    out(c,(ServerFinished,sidF,fingF));

    (* M5 forged by the attacker from the newly established PRK. *)
    in(c,(=ClientFinished,=sidF,finuF:mac_t));
    let th4F = make_th4(th3F,canon_m4(sidF,fingF)) in
    let kfuF = hkdf_expand(prkF,info_fin_u(th4F)) in
    if finuF = hmac(kfuF,hash2bits(th4F)) then
      out(c,future_impersonation_witness).

process
  (
    processPastSessionThenBothBroken()
    |
    processFutureImpersonationAfterLTSK()
  )
