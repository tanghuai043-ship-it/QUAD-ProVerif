(*
QUAD -- Single Long-Term-Secret Disclosure after M6 (Q17-Q22)
ProVerif 2.05

Two separate historical sessions are modeled:
  A: release the UAV-GCS long-term shared key after verified M6 and records.
  B: release the GCS ML-KEM private key after verified M6 and records.

The historical handshake is an orchestrated honest transcript. Both sides
derive and check the Finished messages and traffic keys; the UAV verifies
M6 before records are emitted and disclosure occurs.

The model is scenario-specific, not an interleaved multi-session handshake
proof. It does not establish forward secrecy after simultaneous disclosure
of both long-term materials. Source-IP provenance, expiration, replay
windows, and byte-level cryptographic operations are abstracted.
*)
set traceDisplay = short.
set reconstructTrace = true.
set displayDerivation = false.

free c: channel.

type host.
type ip_t.
type slot_t.
type nonce.
type seq_t.
type len_t.
type gcm_nonce_t.
type pkey.
type skey.
type ss_t.
type ct_t.
type sym_key.
type mac_t.
type cookie_t.
type hash_t.
type sid_t.
type aead_t.

free Dir_U2G: bitstring.
free Dir_G2U: bitstring.
free Epoch0: bitstring.

fun hmac(sym_key, bitstring): mac_t.
fun hash2bits(hash_t): bitstring [data].
fun calc_cookie(sym_key, ip_t, slot_t, nonce): cookie_t.
fun mlkem_pk(skey): pkey.
fun mlkem_encaps_ct(pkey, nonce): ct_t.
fun mlkem_encaps_ss(pkey, nonce): ss_t.
fun mlkem_decaps(skey, ct_t): ss_t.
equation forall k:skey, r:nonce;
  mlkem_decaps(k,mlkem_encaps_ct(mlkem_pk(k),r))
  = mlkem_encaps_ss(mlkem_pk(k),r).

fun canon_m2(slot_t, nonce, cookie_t): bitstring [data].
fun canon_m3(host, slot_t, nonce, nonce, cookie_t, ct_t, mac_t): bitstring [data].
fun canon_m4(sid_t, mac_t): bitstring [data].
fun canon_m5(sid_t, mac_t): bitstring [data].
fun make_th3(bitstring, bitstring, bitstring): hash_t [data].
fun make_th4(hash_t, bitstring): hash_t [data].
fun make_th5(hash_t, bitstring): hash_t [data].
fun make_sid(hash_t): sid_t [data].
fun macu_input(host, host, slot_t, nonce, nonce, cookie_t, ct_t): bitstring [data].
fun info_ksym(hash_t): bitstring [data].
fun info_fin_g(hash_t): bitstring [data].
fun info_fin_u(hash_t): bitstring [data].
fun info_es(bitstring, hash_t): bitstring [data].
fun info_u2g(sid_t, bitstring): bitstring [data].
fun info_g2u(sid_t, bitstring): bitstring [data].
fun hkdf_extract_hs(mac_t, ss_t): sym_key.
fun hkdf_expand(sym_key, bitstring): sym_key.

fun make_gcm_nonce(bitstring, seq_t): gcm_nonce_t [data].
fun make_aad(sid_t, bitstring, bitstring, seq_t, bitstring, len_t): bitstring [data].
fun aead_enc(sym_key, gcm_nonce_t, bitstring, bitstring): aead_t.
reduc forall k:sym_key, n:gcm_nonce_t, ad:bitstring, m:bitstring;
  aead_dec(k,n,ad,aead_enc(k,n,ad,m)) = m.

fun payload_telemetry(bitstring): bitstring [data].
fun payload_command(bitstring): bitstring [data].
reduc forall x:bitstring; get_telemetry(payload_telemetry(x)) = x.
reduc forall x:bitstring; get_command(payload_command(x)) = x.

free ClientHello_Init: bitstring.
free CookieReply: bitstring.
free ClientAuth: bitstring.
free ServerFinished: bitstring.
free ClientFinished: bitstring.
free Payload_READY: bitstring.
free Type_SessionReady: bitstring.
free Type_Telemetry: bitstring.
free Type_Command: bitstring.
free Len_SessionReady: len_t.
free Len_Telemetry_Test: len_t.
free Len_Command_Test: len_t.

free Disclosure_LTSK: bitstring.
free Disclosure_MLKEM: bitstring.

(* Scenario A uses independent long-term material. *)
free sk_A: skey [private].
free ltsk_A: sym_key [private].
free mk_A: sym_key [private].
free id_u_A: host.
free id_g_A: host.
free ip_A: ip_t.
free secret_ltsk_broken: bitstring [private].
free secret_ltsk_broken_g2u: bitstring [private].

(* Scenario B uses DIFFERENT independent long-term material. *)
free sk_B: skey [private].
free ltsk_B: sym_key [private].
free mk_B: sym_key [private].
free id_u_B: host.
free id_g_B: host.
free ip_B: ip_t.
free secret_mlkem_broken: bitstring [private].
free secret_mlkem_broken_g2u: bitstring [private].

event M6Authenticated(host,sid_t).
event HistoricalRecordsEmitted(host,sid_t).
event DisclosureAfterM6(host,sid_t).

(* Four historical-record secrecy queries. *)
query attacker(secret_ltsk_broken).
query attacker(secret_ltsk_broken_g2u).
query attacker(secret_mlkem_broken).
query attacker(secret_mlkem_broken_g2u).

(* Temporal correspondence queries for both disclosure scenarios;
   these do not establish implementation-level liveness. *)
query u:host,s:sid_t;
  event(DisclosureAfterM6(u,s)) ==> event(M6Authenticated(u,s)).
query u:host,s:sid_t;
  event(DisclosureAfterM6(u,s)) ==> event(HistoricalRecordsEmitted(u,s)).

let processEstablishedThenDisclose(
    sk:skey,ltsk:sym_key,mk:sym_key,u:host,g:host,ip_src:ip_t,
    secret_telemetry:bitstring,secret_command:bitstring,
    disclosure_mode:bitstring) =
  let pk = mlkem_pk(sk) in
  out(c,pk);
  out(c,(ip_src,ClientHello_Init));

  new slot:slot_t;
  new ng:nonce;
  let cookie = calc_cookie(mk,ip_src,slot,ng) in
  out(c,(CookieReply,slot,ng,cookie));

  new nu:nonce;
  new encaps_randomness:nonce;
  let ct = mlkem_encaps_ct(pk,encaps_randomness) in
  let ss_u = mlkem_encaps_ss(pk,encaps_randomness) in
  let mac_u = hmac(ltsk,macu_input(u,g,slot,nu,ng,cookie,ct)) in
  out(c,(ip_src,(ClientAuth,u,slot,nu,ng,cookie,ct,mac_u)));

  (* In this orchestrated honest history, ip_src is the address observed on
     BOTH M1 and M3; not an untrusted protocol field. This equality enforces
     the same IP-dependent Cookie formula as the active handshake model. *)
  if cookie = calc_cookie(mk,ip_src,slot,ng) then
    if mac_u = hmac(ltsk,macu_input(u,g,slot,nu,ng,cookie,ct)) then
      let ss_g = mlkem_decaps(sk,ct) in
      let th3 = make_th3(
          ClientHello_Init,canon_m2(slot,ng,cookie),
          canon_m3(u,slot,nu,ng,cookie,ct,mac_u)) in
      let ksym_u = hmac(ltsk,info_ksym(th3)) in
      let ksym_g = hmac(ltsk,info_ksym(th3)) in
      let prk_u = hkdf_extract_hs(ksym_u,ss_u) in
      let prk_g = hkdf_extract_hs(ksym_g,ss_g) in
      let historical_sid = make_sid(th3) in

      (* M4 generated from GCS PRK and verified with UAV PRK. *)
      let fin_g = hmac(hkdf_expand(prk_g,info_fin_g(th3)),hash2bits(th3)) in
      out(c,(ServerFinished,historical_sid,fin_g));
      if fin_g = hmac(hkdf_expand(prk_u,info_fin_g(th3)),hash2bits(th3)) then
        let th4 = make_th4(th3,canon_m4(historical_sid,fin_g)) in
        (* M5 generated from UAV PRK and checked with GCS PRK. *)
        let fin_u = hmac(hkdf_expand(prk_u,info_fin_u(th4)),hash2bits(th4)) in
        out(c,(ClientFinished,historical_sid,fin_u));
        if fin_u = hmac(hkdf_expand(prk_g,info_fin_u(th4)),hash2bits(th4)) then
          let th5 = make_th5(th4,canon_m5(historical_sid,fin_u)) in
          let es_u = hkdf_expand(prk_u,info_es(Epoch0,th5)) in
          let es_g = hkdf_expand(prk_g,info_es(Epoch0,th5)) in
          let ku_u = hkdf_expand(es_u,info_u2g(historical_sid,Epoch0)) in
          let kg_u = hkdf_expand(es_u,info_g2u(historical_sid,Epoch0)) in
          let kg_g = hkdf_expand(es_g,info_g2u(historical_sid,Epoch0)) in

          (* M6 sent under GCS derived G2U key. *)
          new seq_ready:seq_t;
          let aad_ready = make_aad(
              historical_sid,Dir_G2U,Epoch0,seq_ready,Type_SessionReady,Len_SessionReady) in
          let ciphertext_ready = aead_enc(
              kg_g,make_gcm_nonce(Epoch0,seq_ready),aad_ready,Payload_READY) in
          out(c,(historical_sid,Dir_G2U,Epoch0,seq_ready,
                 Type_SessionReady,Len_SessionReady,ciphertext_ready));

          (* UAV explicitly receives and authenticates an M6 from the network. *)
          in(c,(=historical_sid,=Dir_G2U,=Epoch0,recv_seq:seq_t,
                =Type_SessionReady,=Len_SessionReady,recv_ct:aead_t));
          let recv_aad = make_aad(
              historical_sid,Dir_G2U,Epoch0,recv_seq,Type_SessionReady,Len_SessionReady) in
          let ready_plain = aead_dec(
              kg_u,make_gcm_nonce(Epoch0,recv_seq),recv_aad,recv_ct) in
          if ready_plain = Payload_READY then
            event M6Authenticated(u,historical_sid);

            (* Both application records are generated only after verified M6. *)
            new seq_u:seq_t;
            let aad_u = make_aad(
                historical_sid,Dir_U2G,Epoch0,seq_u,Type_Telemetry,Len_Telemetry_Test) in
            out(c,(historical_sid,Dir_U2G,Epoch0,seq_u,
                   Type_Telemetry,Len_Telemetry_Test,
                   aead_enc(ku_u,make_gcm_nonce(Epoch0,seq_u),aad_u,
                            payload_telemetry(secret_telemetry))));
            new seq_g:seq_t;
            let aad_g = make_aad(
                historical_sid,Dir_G2U,Epoch0,seq_g,Type_Command,Len_Command_Test) in
            out(c,(historical_sid,Dir_G2U,Epoch0,seq_g,
                   Type_Command,Len_Command_Test,
                   aead_enc(kg_g,make_gcm_nonce(Epoch0,seq_g),aad_g,
                            payload_command(secret_command))));

            event HistoricalRecordsEmitted(u,historical_sid);
            if disclosure_mode = Disclosure_LTSK then
              ( event DisclosureAfterM6(u,historical_sid); out(c,ltsk) )
            else
              if disclosure_mode = Disclosure_MLKEM then
                ( event DisclosureAfterM6(u,historical_sid); out(c,sk) ).

process
  (
    processEstablishedThenDisclose(
        sk_A,ltsk_A,mk_A,id_u_A,id_g_A,ip_A,
        secret_ltsk_broken,secret_ltsk_broken_g2u,Disclosure_LTSK)
    |
    processEstablishedThenDisclose(
        sk_B,ltsk_B,mk_B,id_u_B,id_g_B,ip_B,
        secret_mlkem_broken,secret_mlkem_broken_g2u,Disclosure_MLKEM)
  )
